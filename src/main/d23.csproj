<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ei8.Cortex.Coding.d23</AssemblyName>
    <RootNamespace>ei8.Cortex.Coding.d23</RootNamespace>
    <PackageId>ei8.Cortex.Coding.d23</PackageId>
    <PackageVersion>0.2.1</PackageVersion>
    <Authors>Elmer Roderick Niem Bool</Authors>
    <Description>Cortex Coding d#</Description>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Initial commit.</PackageReleaseNotes>
    <PackageTags>cortex coding d#</PackageTags>
    <Version>0.2.1</Version>
    <PackageLicenseUrl>https://www.gnu.org/licenses/agpl-3.0.en.html</PackageLicenseUrl>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Grannies\**" />
    <Compile Remove="neurULization\**" />
	  <EmbeddedResource Remove="Grannies\**" />
	  <EmbeddedResource Remove="neurULization\**" />
	  <None Remove="Grannies\**" />
	  <None Remove="neurULization\**" />
	  <Compile Update="Math\Arithmetic\Adder.Types.cs">
		  <DependentUpon>Adder.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Math\Arithmetic\SequentialAdder.Types.cs">
		  <DependentUpon>SequentialAdder.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Math\Arithmetic\Subtractor.Types.cs">
		  <DependentUpon>Subtractor.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Sequences\BiphasicNext.Types.cs">
		  <DependentUpon>BiphasicNext.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Sequences\Next.Types.cs">
		  <DependentUpon>Next.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Math\Logic\DualInputLogicGateBase.Types.cs">
		  <DependentUpon>DualInputLogicGateBase.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Math\Logic\NotGate.Types.cs">
		  <DependentUpon>NotGate.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Process\Iteration\DoUntil.Types.cs">
		  <DependentUpon>DoUntil.cs</DependentUpon>
	  </Compile>
	  <Compile Update="Process\Operation\Addition.Types.cs">
		  <DependentUpon>Addition.cs</DependentUpon>
	  </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ei8.Cortex.Coding" Version="0.3.9" />
    <PackageReference Include="ei8.Cortex.Coding.Spiker" Version="0.1.9" />
  </ItemGroup>
	
</Project>
